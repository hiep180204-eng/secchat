        <mxCell id="recv" value="&lt;b&gt;Người nhận&lt;/b&gt;&lt;br&gt;giải mã E2EE → plaintext&lt;br&gt;(+ cache cục bộ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="220" height="70" as="geometry" /></mxCell>
