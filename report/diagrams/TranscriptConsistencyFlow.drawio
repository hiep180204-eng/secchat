        <mxCell id="bRecv" value="Client B nhận checkpoint&lt;br&gt;(control message đã mã hóa)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="250" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="bCmp" value="So khớp với view cục bộ tại cùng message id" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="360" width="300" height="44" as="geometry" /></mxCell>
        <mxCell id="d1" value="Khớp?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="440" width="140" height="80" as="geometry" /></mxCell>
        <mxCell id="ok" value="View nhất quán" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="570" width="200" height="44" as="geometry" /></mxCell>
        <mxCell id="warn" value="Cảnh báo: split-view / history không nhất quán" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="448" width="120" height="64" as="geometry" /></mxCell>
        <mxCell id="t1" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="aMsgs" target="aHash"><mxGeometry relative="1" as="geometry" /></mxCell>
