        <mxCell id="aHash" value="Tính rolling hash của transcript" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="300" height="44" as="geometry" /></mxCell>
