        <mxCell id="m1" value="get_pqxdh_bundle(B)" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="116" y="96" as="sourcePoint" /><mxPoint x="440" y="96" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="bundle: id_pk, spk+sig, pq_spk+sig, otk, identity_version" style="endArrow=open;dashed=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="128" as="sourcePoint" /><mxPoint x="116" y="128" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="nA" value="Bắt tay PQXDH (phía A):&#xa;• verify chữ ký prekey (Ed25519)&#xa;• eph = X25519 keygen&#xa;• DH1 = DH(spk_A, spk_B)&#xa;• DH2 = DH(eph, spk_B)&#xa;• DH3 = DH(eph, otk_B)&#xa;• (pq_ct, pq_ss) = ML-KEM-1024.encapsulate(pq_spk_B)&#xa;• root = HKDF(DH1‖DH2‖DH3‖pq_ss, &quot;SecChat-PQXDH&quot;)&#xa;• init Double Ratchet" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;fillColor=#fff9b2;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="140" y="150" width="300" height="150" as="geometry" /></mxCell>
        <mxCell id="nKem" value="Kyber / ML-KEM-1024" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="452" y="206" width="150" height="26" as="geometry" /></mxCell>
        <mxCell id="m6" value="message S3PQI { eph_pk, pq_ct, prekey ids, ciphertext }" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="116" y="324" as="sourcePoint" /><mxPoint x="440" y="324" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="chuyển tiếp S3PQI" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="360" as="sourcePoint" /><mxPoint x="764" y="360" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="nB" value="Bắt tay PQXDH (phía B):&#xa;• pq_ss = ML-KEM-1024.decapsulate(pq_ct, pq_sk_B)&#xa;• DH1..DH3 tính lại bằng X25519&#xa;• root = HKDF(DH1‖DH2‖DH3‖pq_ss)  → trùng root của A&#xa;• init Double Ratchet → giải mã tin đầu (S3PQI)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;fillColor=#fff9b2;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="455" y="392" width="300" height="96" as="geometry" /></mxCell>
        <mxCell id="m8" value="các tin sau: S3DR (Double Ratchet)" style="endArrow=block;dashed=1;html=1;strokeColor=#82b366;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="116" y="528" as="sourcePoint" /><mxPoint x="764" y="528" as="targetPoint" /></mxGeometry></mxCell>
