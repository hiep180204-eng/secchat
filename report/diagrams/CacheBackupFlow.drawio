<mxfile host="app.diagrams.net" type="device">
  <diagram name="CacheBackupFlow" id="cache-backup">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="dec" value="Tin đã giải mã" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="220" height="40" as="geometry" /></mxCell>
        <mxCell id="cache" value="Plaintext cache&lt;br&gt;(mã hóa bằng master key, trên thiết bị)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="240" height="54" as="geometry" /></mxCell>
        <mxCell id="state" value="Local E2EE state&lt;br&gt;(identity, prekey, ratchet, group)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="220" height="54" as="geometry" /></mxCell>
        <mxCell id="enc" value="Mã hóa bằng passphrase&lt;br&gt;(PBKDF2 + AES-GCM)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="240" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="bfile" value="File backup E2EE&lt;br&gt;(tùy chọn kèm cache)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="350" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="dec2" value="Giải mã bằng passphrase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="350" width="240" height="44" as="geometry" /></mxCell>
        <mxCell id="rewrap" value="Re-wrap bằng master key hiện tại + merge cache theo message id" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="240" width="240" height="56" as="geometry" /></mxCell>
        <mxCell id="hist" value="Lịch sử đọc lại được&lt;br&gt;(không rollback identity)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="240" height="54" as="geometry" /></mxCell>
        <mxCell id="b1" value="lưu" style="endArrow=block;html=1;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="dec" target="cache"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b2" value="tùy chọn" style="endArrow=block;html=1;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="cache" target="enc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b3" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="state" target="enc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b4" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="enc" target="bfile"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b5" value="restore (thiết bị khác)" style="endArrow=block;html=1;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="bfile" target="dec2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b6" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="dec2" target="rewrap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b7" style="endArrow=block;html=1;strokeColor=#333333;" edge="1" parent="1" source="rewrap" target="hist"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
