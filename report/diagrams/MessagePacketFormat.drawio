<mxfile host="app.diagrams.net" type="device">
  <diagram name="MessagePacketFormat" id="message-packet-format">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="title" value="Đóng gói, truyền và giải mã một tin nhắn DM (wire S3DR)" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#0d1b3e;" vertex="1" parent="1"><mxGeometry x="10" y="8" width="1000" height="30" as="geometry" /></mxCell>

        <!-- ===== PANEL 1: cấu trúc gói tin ===== -->
        <mxCell id="p1" value="1) Cấu trúc gói tin trên dây (tin DM thường — prefix S3DR)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#0d1b3e;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="720" height="22" as="geometry" /></mxCell>

        <mxCell id="wireA" value="&lt;b&gt;S3DR:&lt;/b&gt;&lt;br&gt;5 byte ASCII" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#e2e8f0;strokeColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="30" y="74" width="104" height="42" as="geometry" /></mxCell>
        <mxCell id="wireB" value="base64url( JSON envelope )  —  độ dài thay đổi theo nội dung" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="140" y="74" width="850" height="42" as="geometry" /></mxCell>

        <mxCell id="envlbl" value="JSON envelope:" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="200" height="18" as="geometry" /></mxCell>
        <mxCell id="cv" value="v = 3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="30" y="142" width="80" height="44" as="geometry" /></mxCell>
        <mxCell id="csid" value="sid (16 B)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="116" y="142" width="150" height="44" as="geometry" /></mxCell>
        <mxCell id="ch" value="h : header" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="272" y="142" width="170" height="44" as="geometry" /></mxCell>
        <mxCell id="ceh" value="eh : header đã mã hóa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="448" y="142" width="250" height="44" as="geometry" /></mxCell>
        <mxCell id="cct" value="ct : nội dung đã mã hóa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="704" y="142" width="286" height="44" as="geometry" /></mxCell>

        <mxCell id="hdr" value="&lt;b&gt;h (header — đồng thời là AAD ràng ciphertext)&lt;/b&gt;&lt;br&gt;• dh : khóa công khai ratchet X25519 — 32 B&lt;br&gt;• pn, n : bộ đếm chuỗi (trước / hiện tại)&lt;br&gt;• conversation_id, sender_uid, recipient_uid&lt;br&gt;• sender_identity_version" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="224" width="450" height="122" as="geometry" /></mxCell>

        <mxCell id="ctlbl" value="ct = AES-256-GCM(message key 32 B, plaintext, AAD = header)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="512" y="222" width="478" height="20" as="geometry" /></mxCell>
        <mxCell id="nonce" value="nonce&lt;br&gt;&lt;b&gt;12 B&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="512" y="250" width="130" height="54" as="geometry" /></mxCell>
        <mxCell id="ctext" value="ciphertext&lt;br&gt;&lt;b&gt;L byte&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="648" y="250" width="210" height="54" as="geometry" /></mxCell>
        <mxCell id="tag" value="tag xác thực&lt;br&gt;&lt;b&gt;16 B&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="864" y="250" width="126" height="54" as="geometry" /></mxCell>
        <mxCell id="ctnote" value="Plaintext = { ts, body } ; sửa header hoặc ct đều làm thẻ tag sai." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#3f6212;" vertex="1" parent="1"><mxGeometry x="512" y="312" width="478" height="18" as="geometry" /></mxCell>

        <mxCell id="e_b64" style="endArrow=none;dashed=1;html=1;strokeColor=#94a3b8;" edge="1" parent="1" source="wireB" target="csid"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_h" style="endArrow=none;dashed=1;html=1;strokeColor=#d79b00;" edge="1" parent="1" source="ch" target="hdr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_ct" style="endArrow=none;dashed=1;html=1;strokeColor=#82b366;" edge="1" parent="1" source="cct" target="ctext"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== PANEL 2: hành trình ===== -->
        <mxCell id="p2" value="2) Hành trình: mã hóa tại máy gửi → server chỉ lưu &amp;amp; chuyển tiếp → giải mã tại máy nhận" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#0d1b3e;" vertex="1" parent="1"><mxGeometry x="30" y="372" width="960" height="22" as="geometry" /></mxCell>

        <mxCell id="alice_bg" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="30" y="402" width="300" height="442" as="geometry" /></mxCell>
        <mxCell id="server_bg" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdf0f0;strokeColor=#d9a8a8;" vertex="1" parent="1"><mxGeometry x="362" y="402" width="276" height="442" as="geometry" /></mxCell>
        <mxCell id="bob_bg" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="670" y="402" width="300" height="442" as="geometry" /></mxCell>

        <mxCell id="alice_bar" value="Máy gửi (Alice)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="402" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="server_bar" value="Server (không giữ khóa)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="362" y="402" width="276" height="30" as="geometry" /></mxCell>
        <mxCell id="bob_bar" value="Máy nhận (Bob)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="402" width="300" height="30" as="geometry" /></mxCell>

        <mxCell id="a1" value="Plaintext&lt;br&gt;{ ts, body: &quot;Xin chào&quot; }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="48" y="446" width="264" height="48" as="geometry" /></mxCell>
        <mxCell id="a2" value="Double Ratchet → message key&lt;br&gt;dùng một lần (32 B)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="48" y="506" width="264" height="44" as="geometry" /></mxCell>
        <mxCell id="a3" value="AES-256-GCM mã hóa&lt;br&gt;(AAD = header)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="48" y="562" width="264" height="44" as="geometry" /></mxCell>
        <mxCell id="a4" value="Đóng khung: &quot;S3DR:&quot; +&lt;br&gt;base64url(JSON envelope)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="48" y="618" width="264" height="46" as="geometry" /></mxCell>
        <mxCell id="a5" value="&lt;b&gt;→ wire S3DR: . . .&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="48" y="676" width="264" height="40" as="geometry" /></mxCell>

        <mxCell id="s1" value="Kiểm prefix hợp lệ&lt;br&gt;(S3PQI / S3DR / S3MLS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="378" y="462" width="244" height="46" as="geometry" /></mxCell>
        <mxCell id="s2" value="Lưu messages.body =&lt;br&gt;chuỗi ciphertext (nguyên văn)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="378" y="520" width="244" height="46" as="geometry" /></mxCell>
        <mxCell id="s3" value="Chuyển tiếp tới người nhận" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="378" y="578" width="244" height="40" as="geometry" /></mxCell>
        <mxCell id="s4" value="&lt;b&gt;KHÔNG giải mã được&lt;/b&gt;&lt;br&gt;nội dung tin nhắn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="378" y="630" width="244" height="50" as="geometry" /></mxCell>

        <mxCell id="b1" value="Nhận wire S3DR:, tách prefix" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="688" y="446" width="264" height="40" as="geometry" /></mxCell>
        <mxCell id="b2" value="base64 decode → đọc header,&lt;br&gt;kiểm sid / conv / recipient" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="688" y="498" width="264" height="46" as="geometry" /></mxCell>
        <mxCell id="b3" value="Double Ratchet: tiến/xoay&lt;br&gt;→ dựng lại message key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="688" y="556" width="264" height="44" as="geometry" /></mxCell>
        <mxCell id="b4" value="AES-256-GCM giải mã&lt;br&gt;+ kiểm tag (16 B)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="688" y="612" width="264" height="44" as="geometry" /></mxCell>
        <mxCell id="b5" value="&lt;b&gt;→ Plaintext: &quot;Xin chào&quot;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="688" y="668" width="264" height="40" as="geometry" /></mxCell>

        <mxCell id="arrA" value="WebSocket&lt;br&gt;(trong TLS)" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alice_bg" target="server_bg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="arrB" value="TLS" style="endArrow=block;html=1;strokeColor=#334155;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="server_bg" target="bob_bg"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="foot" value="Tin nhóm: MLS application message (ChaCha20-Poly1305), prefix S3MLS:.&lt;br&gt;Tin DM đầu phiên: S3PQI: kèm transcript PQXDH — ML-KEM-1024 ciphertext 1568 B, identity Ed25519 32 B, signed prekey X25519 32 B + chữ ký 64 B, ephemeral X25519 32 B." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=12;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="856" width="940" height="48" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
