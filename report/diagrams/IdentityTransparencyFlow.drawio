<mxfile host="app.diagrams.net" type="device">
  <diagram name="IdentityTransparencyFlow" id="identity-transparency">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="client" value="&lt;b&gt;Client A&lt;/b&gt;&lt;br&gt;(người gửi)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="server" value="&lt;b&gt;Chat server&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="60" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="log" value="identity_key_log&lt;br&gt;(append-only)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="250" width="160" height="80" as="geometry" /></mxCell>
        <mxCell id="auditor" value="&lt;b&gt;Auditor&lt;/b&gt;&lt;br&gt;dựng Merkle tree, ký checkpoint (Ed25519)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="470" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="note" value="Client kiểm tra:&lt;br&gt;• key trong bundle khớp leaf đã ký?&lt;br&gt;• identity_version đúng?&lt;br&gt;• inclusion proof hợp lệ?&lt;br&gt;• chữ ký checkpoint hợp lệ?&lt;br&gt;• không rollback / split-view?" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9b2;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="260" height="140" as="geometry" /></mxCell>
        <mxCell id="outcome" value="Kết quả: hợp lệ → tăng tin cậy; sai → audit_mismatch; auditor lỗi → audit_unavailable.&lt;br&gt;&lt;b&gt;Cảnh báo tư vấn, KHÔNG chặn gửi tin.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="e1" value="ghi initial / rotation" style="endArrow=block;html=1;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="server" target="log"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="đọc log" style="endArrow=block;html=1;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="auditor" target="log"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="get_pqxdh_bundle → bundle + identity_version" style="endArrow=block;html=1;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="client" target="server"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="xin proof(uid, version)" style="endArrow=block;html=1;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="client" target="auditor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="inclusion proof + checkpoint đã ký" style="endArrow=block;html=1;dashed=1;strokeColor=#b85450;fontSize=9;" edge="1" parent="1" source="auditor" target="client"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=none;dashed=1;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="client" target="outcome"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
