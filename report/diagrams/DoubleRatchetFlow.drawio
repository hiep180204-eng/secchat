        <mxCell id="note" value="Mỗi tin một message key, dùng xong bỏ → lộ một key không lộ tin khác (forward secrecy). Skipped-key cache (giới hạn) cho tin lệch thứ tự." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff9b2;strokeColor=#d6b656;size=14;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="420" width="570" height="80" as="geometry" /></mxCell>
