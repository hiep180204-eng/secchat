        <mxCell id="h_s" value="Sender (Double Ratchet)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="22" width="180" height="34" as="geometry" /></mxCell>
