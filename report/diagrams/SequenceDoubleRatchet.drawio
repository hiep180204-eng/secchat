        <mxCell id="optR1" value="opt  [header.dh ≠ remote_dh]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;fontSize=10;verticalAlign=top;align=left;spacingLeft=4;spacingTop=2;width=170;height=20;" vertex="1" parent="1"><mxGeometry x="300" y="402" width="360" height="62" as="geometry" /></mxCell>
        <mxCell id="nR1" value="dh_ratchet: (root, ck_recv) = KDF_RK(root, DH(dh_sk, remote_dh)); dh mới; (root, ck_send) = KDF_RK(...)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;fillColor=#fff9b2;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="428" width="340" height="32" as="geometry" /></mxCell>
        <mxCell id="optR2" value="opt  [n &gt; n_recv  (lệch thứ tự)]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;fontSize=10;verticalAlign=top;align=left;spacingLeft=4;spacingTop=2;width=180;height=20;" vertex="1" parent="1"><mxGeometry x="300" y="474" width="360" height="60" as="geometry" /></mxCell>
        <mxCell id="nR2" value="skip_until(n): lưu lại message key bị bỏ qua (skipped-key cache ≤ 1000)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;fillColor=#fff9b2;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="500" width="340" height="30" as="geometry" /></mxCell>
        <mxCell id="nDec" value="mk, ck_recv = KDF_CK(ck_recv); AEAD decrypt; chống replay (seen set)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;fillColor=#fff9b2;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="544" width="360" height="30" as="geometry" /></mxCell>
        <mxCell id="nDef" value="KDF_CK(ck) = HKDF(ck) → (ck', mk)    : symmetric ratchet (mỗi tin)&#xa;KDF_RK(root, dh) = HKDF(dh, salt=root) → (root', chain) : DH ratchet (X25519)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="638" width="620" height="42" as="geometry" /></mxCell>
        <mxCell id="nPQ" value="PQ confidentiality đến từ bắt tay PQXDH ban đầu (ML-KEM-1024); ratchet liên tục dùng X25519 — không có KEM định kỳ." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingTop=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="688" width="620" height="26" as="geometry" /></mxCell>
