        <mxCell id="lblE" value="encrypt(plaintext)" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="214" y="92" width="160" height="18" as="geometry" /></mxCell>
        <mxCell id="optE" value="opt  [needs_send_ratchet]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;fontSize=10;verticalAlign=top;align=left;spacingLeft=4;spacingTop=2;width=150;height=20;" vertex="1" parent="1"><mxGeometry x="214" y="116" width="330" height="64" as="geometry" /></mxCell>
        <mxCell id="nE1" value="dh_pk, dh_sk = X25519 keygen&#xa;(root, ck_send) = KDF_RK(root, DH(dh_sk, remote_dh)); n_send = 0" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;fillColor=#fff9b2;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="224" y="142" width="310" height="32" as="geometry" /></mxCell>
        <mxCell id="nSym" value="mk, ck_send = KDF_CK(ck_send)   [symmetric ratchet];  n_send++" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;fillColor=#fff9b2;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="214" y="196" width="330" height="30" as="geometry" /></mxCell>
        <mxCell id="nAead" value="AEAD encrypt(body, mk); mã hóa header(dh_pk, pn, n) bằng hk_send" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;spacingTop=2;verticalAlign=top;fillColor=#fff9b2;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="214" y="240" width="330" height="30" as="geometry" /></mxCell>
        <mxCell id="m_send" value="S3DR { h, eh, ct }   — server chỉ lưu &amp; chuyển tiếp ciphertext" style="endArrow=block;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206" y="360" as="sourcePoint" /><mxPoint x="674" y="360" as="targetPoint" /></mxGeometry></mxCell>
